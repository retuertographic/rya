---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign base_abs = site.url | append: site.baseurl -%}
{%- assign paginas = site.pages | where: "layout", "pagina" | where_exp: "p", "p.sitemap != false" | sort: "url" -%}
{%- for p in paginas %}
  {%- if p.lang == "en" -%}{%- assign es = "/" | append: p.alt -%}{%- assign en = p.url -%}{%- else -%}{%- assign es = p.url -%}{%- assign en = "/" | append: p.alt -%}{%- endif %}
  <url>
    <loc>{{ base_abs }}{{ p.url | xml_escape }}</loc>
    {%- if p.actualizado %}
    <lastmod>{{ p.actualizado | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
    <xhtml:link rel="alternate" hreflang="es" href="{{ base_abs }}{{ es | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ base_abs }}{{ en | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ base_abs }}{{ es | xml_escape }}"/>
  </url>
{%- endfor %}
</urlset>
